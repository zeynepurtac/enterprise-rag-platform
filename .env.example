# ---- Ports (host side) --------------------------------------------------
FRONTEND_PORT=8081
BACKEND_PORT=8080
QDRANT_PORT=6333
OLLAMA_PORT=11434

# ---- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragplatform

# ---- Models -------------------------------------------------------------
# Any Ollama-compatible models. The embedding dimension MUST match the model:
#   nomic-embed-text -> 768   |   mxbai-embed-large -> 1024
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768

# ---- Using OpenAI instead of local Ollama -------------------------------
# The backend talks to any OpenAI-compatible endpoint. To use OpenAI, override
# these on the backend service (docker-compose.override.yml or environment):
#   Ai__BaseUrl=https://api.openai.com/v1
#   Ai__ApiKey=sk-...
#   Ai__ChatModel=gpt-4o-mini
#   Ai__EmbeddingModel=text-embedding-3-small
#   Ai__EmbeddingDimensions=1536
